# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# The two inboxes that receive separate copies of each survey
SURVEY_EMAIL_1=support@example.com
SURVEY_EMAIL_2=operations@example.com

# Must use a sender on a domain verified in Resend
RESEND_FROM_EMAIL=Sologenic Support <support@example.com>
